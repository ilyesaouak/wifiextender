<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- ───────────── Header ───────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi Extender"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bring your Wi-Fi to every room"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="● Off"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ───────────── Power button ───────────── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/pulse"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse" />

            <View
                android:id="@+id/pulse2"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_pulse" />

            <FrameLayout
                android:id="@+id/power"
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_power_off"
                android:clickable="true"
                android:contentDescription="Start or stop the extender"
                android:elevation="10dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/powerIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    app:tint="@color/text_dim" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tap to start"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Turns this phone into a Wi-Fi extender"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <!-- ───────────── Banners ───────────── -->
        <TextView
            android:id="@+id/warning"
            style="@style/Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_red"
            android:textColor="@color/red"
            android:visibility="gone" />

        <TextView
            android:id="@+id/note"
            style="@style/Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_amber"
            android:textColor="@color/amber"
            android:visibility="gone" />

        <!-- ───────────── Live speed ───────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/speedCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live speed" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/text"
                        android:textSize="56sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="8dp"
                        android:text="Mbps"
                        android:textColor="@color/text_dim"
                        android:textSize="18sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/down"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="0.0"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_arrow_down"
                            app:drawableTint="@color/green" />

                        <TextView
                            android:id="@+id/up"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:text="0.0"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:drawableStartCompat="@drawable/ic_arrow_up"
                            app:drawableTint="@color/accent2" />
                    </LinearLayout>
                </LinearLayout>

                <com.ilyes.wifiextender.SparklineView
                    android:id="@+id/spark"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="14dp" />

                <TextView
                    android:id="@+id/peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ───────────── Router signal ───────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/signalCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signal from router" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.ilyes.wifiextender.SignalBarsView
                        android:id="@+id/bars"
                        android:layout_width="40dp"
                        android:layout_height="32dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/signalTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/signalDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hint"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tile"
                    android:padding="12dp"
                    android:textColor="@color/text" />

                <TextView
                    android:id="@+id/channelInfo"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ───────────── Connect iPhone ───────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connectCard"
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect your iPhone" />

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Point the iPhone camera at code 1 to join, then at code 2 to set the proxy automatically." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/qrWifi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:background="@drawable/bg_qr"
                            android:contentDescription="QR code to join the Wi-Fi"
                            android:padding="10dp" />

                        <TextView
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="1 · Join Wi-Fi"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Space
                        android:layout_width="14dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/qrProfile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:adjustViewBounds="true"
                            android:background="@drawable/bg_qr"
                            android:contentDescription="QR code to install the proxy setting"
                            android:padding="10dp" />

                        <TextView
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="2 · Set proxy"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="After code 2: tap Allow, then Settings → Profile Downloaded → Install."
                    android:textSize="13sp" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Or enter manually" />

                <include
                    android:id="@+id/rowSsid"
                    layout="@layout/row_info" />

                <include
                    android:id="@+id/rowPass"
                    layout="@layout/row_info" />

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Then Wi-Fi → (i) → Configure Proxy → Manual:"
                    android:textSize="13sp" />

                <include
                    android:id="@+id/rowServer"
                    layout="@layout/row_info" />

                <include
                    android:id="@+id/rowPort"
                    layout="@layout/row_info" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ───────────── Stats tiles ───────────── -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connections" />

                    <TextView
                        android:id="@+id/connections"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@color/text"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data shared" />

                    <TextView
                        android:id="@+id/dataShared"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 B"
                        android:textColor="@color/text"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ───────────── Settings ───────────── -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed settings" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_tile"
                        android:importantForAccessibility="no"
                        android:padding="8dp"
                        android:src="@drawable/ic_bolt"
                        app:tint="@color/amber" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turbo mode" />

                        <TextView
                            style="@style/Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Keeps the screen on (dimmed) for the lowest delay"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/turbo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bandSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="18dp"
                        android:background="@color/stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tile"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Extender channel" />

                            <TextView
                                android:id="@+id/bandHint"
                                style="@style/Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="“Match router” is fastest on most phones"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/band"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/bandMatch"
                            style="@style/BandChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Match router" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/band5g"
                            style="@style/BandChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 GHz" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/band2g"
                            style="@style/BandChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.4 GHz" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/bandAuto"
                            style="@style/BandChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Auto" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Keep this phone plugged in, halfway between the router and your room.\nSpeed test on iPhone: open 192.168.49.1:8282 in Safari."
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
